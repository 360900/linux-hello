option('pam_dir', type: 'string', value: '', description: 'Set the pam_linux_hello destination directory')
option('config_dir', type: 'string', value: '', description: 'Set the linux-hello-cli config directory')
option('dlib_data_dir', type: 'string', value: '', description: 'Set the dlib data directory')
option('dlib_data_files', type: 'string', value: '', description: 'Directory with the unpacked dlib model files (tools/fetch_dlib_data.sh) to install into dlib_data_dir')
option('state_dir', type: 'string', value: '/var/lib/linux-hello', description: 'Set the state directory (face models, PAM manifest)')
option('user_models_dir', type: 'string', value: '', description: 'Set the user models directory (default: <state_dir>/models)')
option('log_path', type: 'string', value: '/var/log/linux-hello', description: 'Set the log file path')
option('install_in_site_packages', type: 'boolean', value: false, description: 'Install Linux Hello python files in site packages')
option('py_sources_dir', type: 'string', value: '', description: 'Set the python sources directory')
option('python_path', type: 'string', value: '/usr/bin/python3', description: 'Set the path to the python executable')
option('bundled_python_dir', type: 'string', value: '', description: 'Path to a prebuilt python runtime from tools/build_runtime.sh; installed to lib/linux-hello-runtime and used instead of python_path')
option('with_webauthn', type: 'boolean', value: true, description: 'Install the optional WebAuthn authenticator (based on PR #1125)')
