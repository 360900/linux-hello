[Unit]
Description=Linux Hello face authentication service
Documentation=man:linux-hello-cli(1)

[Service]
Type=dbus
BusName=io.github.LinuxHello1
ExecStart=@daemon_path@

# The service only needs the camera, its own state, the config and the PAM
# service files it manages. systemd creates the directories below before
# ProtectSystem=strict makes their parents read-only.
@writable_dirs@
ReadWritePaths=/etc/pam.d
# kscreenlockerrc, which turns on face unlock on the Plasma lock screen
ReadWritePaths=-/etc/xdg
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=char-video4linux rw
# OpenVINO runs on the iGPU
DeviceAllow=char-drm rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
