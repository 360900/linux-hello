# Builds the current master branch with the bundled Python runtime.
# The pinned downloads below come from tools/runtime-manifest.json; refresh
# them with tools/update_pkgbuild.py after changing the manifest.
# LINUX_HELLO_GIT overrides the repository, e.g. for local builds:
#   LINUX_HELLO_GIT="git+file://$HOME/linux-hello#branch=remake" makepkg

pkgname=linux-hello-git
