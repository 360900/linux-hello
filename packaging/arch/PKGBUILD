)
makedepends=('cmake' 'extra-cmake-modules' 'git' 'meson' 'ninja' 'python')
provides=('linux-hello')
conflicts=('linux-hello')
install=linux-hello.install
# The bundled CPython must not be stripped again
options=('!strip' '!debug')

