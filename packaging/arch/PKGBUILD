# END pinned sources

pkgver() {
	cd linux-hello
	printf "%s.r%s.g%s" "$(cat VERSION)" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
	cd linux-hello
	# makepkg has downloaded and verified everything into $srcdir
	tools/build_runtime.sh --outdir "$srcdir/runtime" --download-dir "$srcdir" --offline

	arch-meson . "$srcdir/build" \
		-Dbundled_python_dir="$srcdir/runtime/linux-hello-runtime" \
		-Ddlib_data_files="$srcdir"
	meson compile -C "$srcdir/build"

	cmake -B "$srcdir/build-kcm" -S kcm -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_BUILD_TYPE=None \
		-DBUILD_TESTING=OFF
	cmake --build "$srcdir/build-kcm"
}

package() {
	meson install -C "$srcdir/build" --destdir "$pkgdir" --no-rebuild
	DESTDIR="$pkgdir" cmake --install "$srcdir/build-kcm"
	install -Dm644 linux-hello/NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
